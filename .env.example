# Origine publique du site (sans slash final).
# Sert aux metadata, aux URL canoniques, au sitemap et au robots.txt.
# Par défaut https://estimer-mon-auto.fr — à surcharger pour un sous-domaine de test.
# NEXT_PUBLIC_SITE_URL=https://estimer-mon-auto.fr

# Réservé pour la future intégration Supabase
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ENVOI DES EMAILS — notification de lead + confirmation au prospect.
# Sans l'une de ces deux configurations, rien n'est envoyé (seulement un log).
#
# Option recommandée : la boîte mail incluse avec l'hébergement o2switch.
# À créer dans cPanel > Comptes de messagerie, puis renseigner ici.
# SMTP_HOST=mail.estimer-mon-auto.fr
# SMTP_PORT=465
# SMTP_USER=contact@estimer-mon-auto.fr
# SMTP_PASSWORD=
# MAIL_FROM=contact@estimer-mon-auto.fr
#
# Option alternative : service tiers Resend (compte à créer sur resend.com).
# RESEND_API_KEY=

# Monitoring d'erreurs (Sentry) — sans ces variables, le SDK ne fait rien
# (voir instrumentation.ts / instrumentation-client.ts)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
