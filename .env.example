# Origine publique du site (sans slash final).
# Sert aux metadata, aux URL canoniques, au sitemap et au robots.txt.
# Par défaut https://estimez-mon-auto.fr — à surcharger pour un sous-domaine de test.
# NEXT_PUBLIC_SITE_URL=https://estimez-mon-auto.fr

# Réservé pour la future intégration Supabase
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Réservé pour un futur envoi d'email (ex: Resend)
# RESEND_API_KEY=

# Monitoring d'erreurs (Sentry) — sans ces variables, le SDK ne fait rien
# (voir instrumentation.ts / instrumentation-client.ts)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
