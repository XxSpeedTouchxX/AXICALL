3:["$","h2",null,{"children":"Combien ça coûte ?"}]
4:["$","p",null,{"children":"La commission varie selon les agences et la valeur du véhicule. Elle est prélevée uniquement en cas de vente : si le véhicule ne se vend pas, vous ne payez rien dans la grande majorité des modèles du marché. C'est un point à vérifier explicitement dans le mandat, car les pratiques diffèrent d'une enseigne à l'autre."}]
5:["$","p",null,{"children":"La bonne façon de juger le coût n'est pas de le comparer à zéro, mais à ce qu'il remplace : le temps passé à gérer une vente entre particuliers, le risque de négociation ratée, et l'incertitude sur la fiabilité de l'acheteur."}]
6:["$","h2",null,{"children":"Combien de temps pour vendre ?"}]
7:["$","p",null,{"children":"Le délai dépend du véhicule, de son prix, et du dynamisme du marché local au moment de la mise en vente. Il n'existe pas de délai garanti universel, et toute promesse de délai fixe doit être regardée avec prudence. La bonne question à poser à l'agence est : « Sur quel type de véhicule et sur quelle période portent vos délais moyens ? »"}]
8:["$","h2",null,{"children":"Dépôt-vente ou reprise / rachat cash : la vraie différence"}]
9:["$","p",null,{"children":["La reprise en concession et le rachat cash offrent tous les deux un prix inférieur au marché, en échange de la rapidité. Le dépôt-vente vise le prix du marché, en échange d'un délai plus long. Ce n'est pas une question de qualité de service, c'est une conséquence directe du modèle économique de chaque solution : un acheteur qui revend prend une marge, une agence en dépôt-vente prend une commission sur un prix que vous validez."," ",["$","$L1b",null,{"href":"/reprise-ou-depot-vente","children":"Voir le comparatif chiffré reprise / dépôt-vente"}],"."]}]
a:["$","h2",null,{"children":"Les questions les plus fréquentes"}]
b:["$","div","Puis-je récupérer mon véhicule si je change d'avis ?",{"children":[["$","h3",null,{"children":"Puis-je récupérer mon véhicule si je change d'avis ?"}],["$","p",null,{"children":"Les conditions dépendent du mandat signé — c'est un point à clarifier avant signature, pas après."}]]}]
c:["$","div","Que se passe-t-il si le véhicule ne se vend pas dans le délai prévu ?",{"children":[["$","h3",null,{"children":"Que se passe-t-il si le véhicule ne se vend pas dans le délai prévu ?"}],["$","p",null,{"children":"Selon les agences, le mandat est renouvelé, ajusté en prix, ou le véhicule est restitué. À faire préciser à l'avance."}]]}]
d:["$","div","Le prix minimum est-il négociable après signature ?",{"children":[["$","h3",null,{"children":"Le prix minimum est-il négociable après signature ?"}],["$","p",null,{"children":"Non, sauf accord explicite de votre part : c'est justement l'objet du prix plancher que vous fixez ensemble."}]]}]
e:["$","div",null,{"className":"my-10 border border-line bg-white p-6 sm:p-7","children":[["$","p",null,{"className":"eyebrow mb-4","children":"— L'essentiel à retenir"}],["$","ul",null,{"className":"flex list-none flex-col gap-3 p-0","children":[["$","li","Le dépôt-vente délègue la totalité du processus, du contact acheteur jusqu'aux formalités.",{"className":"relative pl-6 text-[0.95rem] leading-relaxed text-muted","children":[["$","span",null,{"className":"absolute left-0 font-bold text-accent","aria-hidden":"true","children":"+"}],"Le dépôt-vente délègue la totalité du processus, du contact acheteur jusqu'aux formalités."]}],["$","li","Vous gardez le contrôle du prix minimum, jamais imposé sans votre accord.",{"className":"relative pl-6 text-[0.95rem] leading-relaxed text-muted","children":[["$","span",null,{"className":"absolute left-0 font-bold text-accent","aria-hidden":"true","children":"+"}],"Vous gardez le contrôle du prix minimum, jamais imposé sans votre accord."]}],["$","li","La commission n'est due qu'en cas de vente, dans la grande majorité des mandats du marché.",{"className":"relative pl-6 text-[0.95rem] leading-relaxed text-muted","children":[["$","span",null,{"className":"absolute left-0 font-bold text-accent","aria-hidden":"true","children":"+"}],"La commission n'est due qu'en cas de vente, dans la grande majorité des mandats du marché."]}],["$","li","C'est la seule solution qui vise le prix du marché sans demander votre temps.",{"className":"relative pl-6 text-[0.95rem] leading-relaxed text-muted","children":[["$","span",null,{"className":"absolute left-0 font-bold text-accent","aria-hidden":"true","children":"+"}],"C'est la seule solution qui vise le prix du marché sans demander votre temps."]}]]}]]}]
