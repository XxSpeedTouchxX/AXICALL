eut représenter plusieurs centaines, parfois plusieurs milliers d'euros selon le véhicule."}],["$","h2",null,{"children":"Comparatif direct"}],["$","div",null,{"className":"my-8 overflow-x-auto border border-line","children":["$","table",null,{"className":"w-full min-w-[520px] border-collapse text-left text-[0.95rem]","children":[["$","caption",null,{"className":"sr-only","children":"Reprise en concession comparée au dépôt-vente en agence"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","Critère",{"scope":"col","className":"border-b-2 border-line px-4 py-3 font-bold tracking-tight text-ink bg-paper/60","children":"Critère"}],["$","th","Reprise concession",{"scope":"col","className":"border-b-2 border-line px-4 py-3 font-bold tracking-tight text-ink bg-paper/60","children":"Reprise concession"}],["$","th","Dépôt-vente en agence",{"scope":"col","className":"border-b-2 border-line px-4 py-3 font-bold tracking-tight text-ink bg-accent/10","children":"Dépôt-vente en agence"}]]}]}],["$","tbody",null,{"children":[["$","tr","Prix obtenu",{"children":[["$","td","0",{"className":"border-b border-line px-4 py-3 align-top font-semibold text-ink ","children":"Prix obtenu"}],["$","td","1",{"className":"border-b border-line px-4 py-3 align-top text-muted ","children":"En dessous du marché, intègre la marge du concessionnaire"}],["$","td","2",{"className":"border-b border-line px-4 py-3 align-top text-muted bg-accent/[0.06]","children":"Proche du prix du marché, moins une commission connue à l'avance"}]]}],["$","tr","Délai",{"children":[["$","td","0",{"className":"border-b border-line px-4 py-3 align-top font-semibold text-ink ","children":"Délai"}],["$","td","1",{"className":"border-b border-line px-4 py-3 align-top text-muted ","children":"Immédiat"}],["$","td","2",{"className":"border-b border-line px-4 py-3 align-top text-muted bg-accent/[0.06]","children":"1 à 4 semaines en moyenne, variable selon le véhicule"}]]}],"$L2","$L3","$L4"]}]]}]}],"$L5","$L6","$