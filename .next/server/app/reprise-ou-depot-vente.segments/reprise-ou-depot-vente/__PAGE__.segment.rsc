6:["$","ul",null,{"children":[["$","li",null,{"children":"Vous achetez un véhicule neuf ou d'occasion chez ce professionnel de toute façon."}],["$","li",null,{"children":"La simplicité immédiate compte plus que l'écart de prix."}],["$","li",null,{"children":"Vous n'avez pas de contrainte de délai particulière à respecter."}]]}]
